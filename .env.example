# 🔴 provider 순서 (2026-10-23 — Spec §0): 기본 **ANTHROPIC → GROQ** (키가 있는 첫 번째). 한도·키 무효면 다음 단계로.
#    OpenAI·Gemini는 사슬 밖 — `--provider openai|gemini`로 명시할 때만 쓴다.

# OpenAI — 사슬 밖(키 무효 2026-09-28~). 명시할 때만: --provider openai
# (2026-08-17~09-30에는 기본이었다.)
# Cloud Functions 서버 전용 — 클라이언트 번들에 절대 포함 금지.
# 배포용은 이 파일이 아니라 Secret Manager에 등록한다:
#   firebase functions:secrets:set OPENAI_API_KEY --data-file <파일>
OPENAI_API_KEY=YOUR_API_KEY

# Gemini — 사슬 밖(2026-10-23 — 무료 티어는 입력을 학습에 쓴다, Tasks L02). 명시할 때만:
# npm run proxy -- --provider gemini
# (2026-10-01~10-22에는 기본, 그전에는 예비였다. 배포 Functions는 사슬 시크릿 등록 전까지 임시 기본으로 쓴다.)
# 🔴 무료 티어는 모델당 하루 20건이다 — 20건 회귀 세트를 한 번 돌리면 그날 소진된다.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Anthropic(Claude) — **기본 provider**(2026-10-23, 사슬 1번). 이 키가 있으면 proxy·refine-live·Worker가 anthropic을 고른다.
# 사고(thinking)는 기본으로 끈다 — 실험으로 켤 때만 SAI_ANTHROPIC_THINKING=adaptive
# 🔴 이름이 `ANTHROPIC_API_KEY`여야 한다(공식 SDK 관례). 2026-10-21부터 temperature를 받지 않아 결과가 매번 조금씩 다르다.
ANTHROPIC_API_KEY=

# Groq — **폴오버 예비**(2026-10-23, 사슬 2번, openai/gpt-oss-120b). ANTHROPIC 키가 없으면 기본이 된다.
# 🔴 무료 플랜은 분당 토큰 8K — 연달아 부르면 429. 콘솔 Data Controls에서 무보존(ZDR)을 켠다.
GROQ_API_KEY=

# Worker 주간 점검(npm --prefix workers/refine run report)이 읽는 서비스 계정 키 **파일 경로**(2026-10-27, M2).
# 🔴 키 값이 아니라 경로다. 키 파일은 저장소 밖에 둔다(예: C:/keys/sai-report.json). 셸에서 실행 때만 넘겨도 된다.
# SAI_SERVICE_ACCOUNT_FILE=

# LLM 응답 캐시 수명(ms). 비워 두면 기본 10분.
# 🔴 시연 촬영처럼 같은 문장을 몇 시간에 걸쳐 반복할 때만 올린다 — 그 시간 동안 API 호출이 0건이다.
#    상한 6시간(넘겨 적으면 6시간으로 잘린다). 프로세스 메모리 전용이라 서버를 재시작하면 사라진다.
#    예) 4시간: 14400000
# SAI_CACHE_TTL_MS=14400000

# 사이트 개발 빌드 스위치(2026-10-24 — docs/WebSplit.md 「C — 로컬 브리지」).
# 🔴 여기 적어도 효과가 없다 — vite 빌드는 이 파일을 process.env로 읽지 않는다. `npm run build:sitedev`가 켠다.
#    켜진 빌드에는 http://localhost:5180 이 externally_connectable에 들어가므로 배포하지 않는다.
# SAI_SITE_DEV=1

# Firebase 웹 앱 구성 (콘솔 > 프로젝트 설정 > 일반에서 복사)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
