# OpenAI — Spec §6-3 기준 provider. **로컬·배포 모두 기본값이다** (2026-08-17).
# 이 키가 있으면 proxy·refine-live·배포된 refineV1이 전부 openai를 고른다.
# Cloud Functions 서버 전용 — 클라이언트 번들에 절대 포함 금지.
# 배포용은 이 파일이 아니라 Secret Manager에 등록한다:
#   firebase functions:secrets:set OPENAI_API_KEY --data-file <파일>
OPENAI_API_KEY=YOUR_API_KEY

# Gemini — 대체 provider. OPENAI_API_KEY가 없을 때만 자동 선택된다.
# 명시 선택: npm run proxy -- --provider gemini
# 🔴 2026-08-19부터 **예비 provider**로도 쓰인다 — OpenAI가 한도(429)에 걸리면 자동으로
#    한 번 더 이쪽으로 부른다(한도일 때만 · 요청이 provider를 명시하지 않았을 때만).
# 🔴 무료 티어는 모델당 하루 20건이다 — 20건 회귀 세트를 한 번 돌리면 그날 소진된다.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# LLM 응답 캐시 수명(ms). 비워 두면 기본 10분.
# 🔴 시연 촬영처럼 같은 문장을 몇 시간에 걸쳐 반복할 때만 올린다 — 그 시간 동안 API 호출이 0건이다.
#    상한 6시간(넘겨 적으면 6시간으로 잘린다). 프로세스 메모리 전용이라 서버를 재시작하면 사라진다.
#    예) 4시간: 14400000
# SAI_CACHE_TTL_MS=14400000

# Firebase 웹 앱 구성 (콘솔 > 프로젝트 설정 > 일반에서 복사)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
