rules_version = '2';

// 🔴 Zero Retention (Spec 필수 5 / CLAUDE.md 최상단 금지):
//    **메시지 본문을 Firestore에 저장하지 않는다.** 저장 허용은 카운트·메타데이터·diff 수치뿐.
//    규칙만으로 "본문인지"를 판별할 수는 없으므로, 아래 두 가지로 좁힌다:
//      ① 문서에 쓸 수 있는 **필드 이름을 화이트리스트**로 고정한다 (본문이 들어갈 자리를 없앤다).
//      ② 문자열 필드에 **길이 상한**을 둔다 (긴 본문이 태그를 가장해 들어오는 것을 막는다).
//    이 규칙은 S08 리뷰 체크리스트의 검증 대상이다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 🔴 **쓰기 전용 조건이다. `read`·`delete`에 걸면 안 된다.**
    //    읽기·삭제 요청에는 `request.resource`가 아예 없어서 이 식이 평가에 실패하고, 규칙은
    //    실패를 **거부**로 처리한다 — 소유자인데도 403이 난다.
    //    2026-08-14 실제로 이 함정에 빠졌다: `users`가 `allow read, write: ... onlyFields(...)`로
    //    묶여 있어 동기화의 **첫 GET부터** 403이었다. 그래서 아래 모든 컬렉션은
    //    `read, delete`(소유자만)와 `create, update`(소유자 + 필드 화이트리스트)를 **분리한다**.
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // 개인 프로필 — 자기신고 성향값과 온보딩 결과. 본문 없음.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && onlyFields(['language', 'partnerRegions', 'tone', 'honorificLevel',
                       'directness', 'emojiPreference', 'updatedAt']);
    }

    // 🔴 Diff 학습 — **수치만** 적재한다 (Spec 필수 2 / audit 6).
    //    교정 전/후 텍스트는 절대 들어오지 않는다. `kind`는 'cushion_insert' 같은 라벨이며
    //    64자를 넘을 수 없다 — 본문을 라벨로 위장해 넣는 경로를 막는다.
    match /users/{userId}/learnedPatterns/{patternId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && onlyFields(['kind', 'count', 'distance', 'updatedAt'])
        && request.resource.data.kind is string
        && request.resource.data.kind.size() <= 64
        && request.resource.data.count is int
        && request.resource.data.count >= 0;
    }

    // 용어집 (Spec 필수 7). 용어는 본문이 아니라 사용자가 등록한 짧은 대응쌍이다.
    match /users/{userId}/glossary/{entryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && onlyFields(['sourceText', 'targetText', 'keepSource', 'entryType', 'updatedAt'])
        && request.resource.data.sourceText is string
        && request.resource.data.sourceText.size() <= 200;
    }

    // 🔴 마찰 카운트 (Spec §3 F-10/F-26) — 조직 단위 **집계 수치만**.
    //    클라이언트가 직접 쓰지 못하게 하고 서버(Functions)만 쓴다.
    //    🔴 읽기도 **팀원에게만** 연다(2026-08-15). 예전에는 로그인만 하면 누구나 읽을 수 있었다 —
    //       팀 id만 알면 남의 조직 지표가 보였다. 문서 id가 `{teamId}_{dateKey}`라 팀 id는
    //       추측 가능한 값이고, 「인증됨」은 「그 팀 사람」과 전혀 다른 조건이다.
    //    🔴 **팀원이라고 다 보는 것이 아니다**(2026-08-15). 대시보드는 팀 전체의 마찰이 보이는
    //       화면이라 팀장이 열어 준 사람만 읽는다. 서버(`teams.js`)만 막으면 Firestore를 직접
    //       읽어 우회할 수 있으므로 **규칙에서 막는 것이 진짜 방어선**이다.
    match /frictionCounts/{docId} {
      function myMembership() {
        return get(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)).data;
      }
      function isPermitted() {
        return exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid))
          && (myMembership().role == 'owner' || myMembership().canViewDashboard == true);
      }
      /**
       * 🔴 **없는 문서를 먼저 허용한다** (2026-08-15). 대시보드는 최근 30일치를 문서 id로 계산해
       *    `batchGet`으로 한 번에 읽는데, 그중 대부분은 **아직 존재하지 않는 날짜**다. 없는 문서에는
       *    `resource`가 없어서 `resource.data.teamId` 평가가 실패하고, 규칙은 실패를 **거부**로
       *    처리한다 — 한 건이라도 거부되면 `batchGet` 전체가 403이 되어 **실데이터가 통째로
       *    안 온다.** 없는 문서를 허용해도 새어 나갈 내용이 없다(내용 자체가 없다).
       */
      allow read: if request.auth != null && (resource == null || isPermitted());
      allow write: if false;
    }

    /**
     * 🔴 일일 교정 상한 카운터 (2026-08-17 신설, `functions/refineQuota.js`).
     *    문서 id는 `{uid}_{YYYY-MM-DD}`이고 내용은 `uid`·`dateKey`·`count`·`updatedAt`뿐이다.
     *
     * 🔴 **클라이언트는 읽지도 쓰지도 못한다.** 쓰기를 열면 상한이 의미를 잃고(스스로 0으로
     *    되돌리면 그만이다), 읽기를 열면 문서 id가 `{uid}_{날짜}`라 **남의 uid로 사용량을
     *    조회**할 수 있다. 서버(Admin SDK)는 규칙을 우회하므로 카운트에는 지장이 없다.
     *    사용자에게 남은 횟수를 보여줄 일이 생기면 규칙을 여는 대신 **Functions가 응답에 실어** 준다.
     */
    match /refineQuota/{docId} {
      allow read, write: if false;
    }

    /**
     * 팀 (Spec §3 — 팀 용어집 동기화 · 건강도 지수). 2026-08-15 신설.
     *
     * 🔴 **가입은 서버만 한다.** 초대 코드 검증이 규칙으로는 불가능하다 — 규칙에서 다른 문서의
     *    코드와 대조하려면 그 문서를 읽을 수 있어야 하고, 읽을 수 있으면 코드가 노출된다.
     *    그래서 `members` 쓰기는 전부 막고 Functions(Admin SDK)만 만든다.
     * 🔴 **`inviteCode`가 클라이언트로 나가면 안 된다.** 팀 문서 자체를 읽지 못하게 하고,
     *    화면에 필요한 이름은 가입 시 서버가 응답으로 돌려준다.
     */
    match /teams/{teamId} {
      allow read, write: if false;

      /**
       * 팀원 명부 — 자기 소속·권한 확인용. 쓰기는 서버 전용(초대 코드 검증·역할 판정 때문).
       * 🔴 **그 팀의 팀원만 읽는다**(2026-08-15 수정). 예전에는 `request.auth != null`이라
       *    로그인한 아무나 남의 팀 명부(uid·이메일)를 읽을 수 있었다 — 「인증됨」과 「그 팀
       *    사람」은 다른 조건이다. 자기 문서 존재로 판정하므로 소속 확인은 여전히 된다.
       */
      match /members/{uid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
        allow write: if false;
      }

      /**
       * 팀 용어집 — 🔴 **본문이 아니라 사용자가 등록한 짧은 대응쌍이다**(개인 용어집과 같은 규칙).
       *    필드 화이트리스트 + 길이 상한으로 본문이 용어를 가장해 들어오는 경로를 막는다.
       * 🔴 읽기·쓰기 모두 **그 팀의 팀원만**. 팀 id를 아는 것과 팀원인 것은 다르다.
       */
      match /glossary/{entryId} {
        function isMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
        }
        allow read, delete: if isMember();
        allow create, update: if isMember()
          && onlyFields(['sourceText', 'targetText', 'keepSource', 'updatedAt', 'updatedBy'])
          && request.resource.data.sourceText is string
          && request.resource.data.sourceText.size() <= 200
          && (!('targetText' in request.resource.data)
              || request.resource.data.targetText.size() <= 200);
      }
    }

    // 그 밖의 모든 경로는 기본 차단 — 새 컬렉션은 규칙을 먼저 쓰고 열어야 한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
